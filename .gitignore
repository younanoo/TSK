# backups and temp files - keep them in ..\backups, not in the site
*.tar.gz
*.zip
*.bak
*.bak_*
_backup*
*.tmp
# OS / editor junk
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# original (full-size) images: only the optimized copies in img/web are published
img/*
!img/web/
node_modules/
_tmp_lt/

# python cache
__pycache__/
_tools/.hashcache.json
_tools/_dbg.js
_tools/.sizecache.json

# نسخ JPG احتياطية للصور (WebP هو المستخدم)
img/web/*.jpg

# مجلد مراجعة الأسفار (يحوي صفحات من كتاب محمي، لا يُرفع)
_review/
